PORT=3000

# --- AI diagnosis assistant --------------------------------------------------
# Anthropic API key used by the /api/diagnose route (host view). Without it the
# diagnosis panel still captures screens but shows a "not configured" message.
# Never expose this to the browser — it is only read server-side.
# ANTHROPIC_API_KEY=sk-ant-...

# --- SMS (send join link by text) --------------------------------------------
# TextBelt API key (pay-as-you-go, no monthly fee). Buy credits at textbelt.com.
# If unset, the app uses the shared "textbelt" test key = 1 free SMS per day.
# TEXTBELT_API_KEY=your-textbelt-key

# --- Optional TURN relay -----------------------------------------------------
# Leave these blank to use Google's free STUN server only (works for the large
# majority of phone-to-desktop connections). Fill them in to add a TURN relay
# fallback for restrictive networks where direct peer-to-peer fails.
#
# Get these from a TURN provider (recommended over self-hosting):
#   - Cloudflare TURN  (cheap, generous free tier)
#   - Metered / Open Relay  (free tier)
#   - Xirsys, Twilio, or self-hosted coturn
#
# Comma-separate multiple URLs. Include both turn: (UDP/TCP) and turns: (TLS).
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password
